using Gtk 4.0;
using Adw 1;

template $AppleMusicWindow: Adw.ApplicationWindow {
  title: _("Music Sleeve");
  width-request: 360;
  height-request: 294;

  // The last breakpoint that matches is the one applied, so the narrower one repeats the
  // wider one's setters.
  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split_view.collapsed: true;
      sidebar.mode: page;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      split_view.collapsed: true;
      sidebar.mode: page;
      player_bar.compact: true;
      now_playing.compact: true;
    }
  }

  // Disjoint from the two above: the Now Playing sheet's two-column layout.
  Adw.Breakpoint {
    condition ("min-width: 900sp")

    setters {
      now_playing.wide: true;
    }
  }

  // The Now Playing sheet in a window too low for its artwork over the titles: `short`
  // puts a small cover beside them (widgets/now_playing.py). Only the last breakpoint that
  // matches applies, so each width band above has a short variant repeating its setters.
  Adw.Breakpoint {
    condition ("max-width: 900sp and max-height: 880sp")

    setters {
      now_playing.short: true;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 640sp and max-height: 880sp")

    setters {
      split_view.collapsed: true;
      sidebar.mode: page;
      now_playing.short: true;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 600sp and max-height: 880sp")

    setters {
      split_view.collapsed: true;
      sidebar.mode: page;
      player_bar.compact: true;
      now_playing.compact: true;
      now_playing.short: true;
    }
  }

  Adw.Breakpoint {
    condition ("min-width: 900sp and max-height: 640sp")

    setters {
      now_playing.wide: true;
      now_playing.short: true;
    }
  }

  // The player bar is the bottom sheet's bottom bar, always shown under the content and the
  // window's full width (not full-width, it floats over the content as a pill the width of
  // its controls, which covers the tiles); the sheet over it is Now Playing
  // (widgets/now_playing.blp), which the bar's click, a swipe and app.now-playing open.
  // Toasts go over the content, above the bar, or into the sheet while it is open.
  content: Adw.BottomSheet bottom_sheet {
    bottom-bar: $AppleMusicPlayerBar player_bar {};

    sheet: $AppleMusicNowPlayingSheet now_playing {};

    // The bar is laid over the content, not under it: the content ends above the bar.
    content: Adw.ToastOverlay toast_overlay {
      margin-bottom: bind bottom_sheet.bottom-bar-height;

    child: Adw.NavigationSplitView split_view {
      min-sidebar-width: 220;
      max-sidebar-width: 280;

      // The sidebar's header bar carries the page's title, the app's name, as GNOME's core
      // apps title theirs.
      sidebar: Adw.NavigationPage {
        title: _("Music Sleeve");
        tag: "sidebar";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [end]
            MenuButton primary_menu_button {
              icon-name: "open-menu-symbolic";
              menu-model: primary_menu;
              tooltip-text: _("Main Menu");
              primary: true;
            }
          }

          content: Adw.Sidebar sidebar {};

          // The account: Sign In… while signed out (it opens the sign-in); the name (or
          // "Signed In") over a menu with Sign Out… (and Sign In Again… once the session has
          // expired) once signed in, which window.py builds. Both buttons are labelled, so
          // neither has a tooltip: the label is the name assistive technology reads.
          [bottom]
          Stack account_stack {
            hhomogeneous: true;
            vhomogeneous: true;
            margin-start: 6;
            margin-end: 6;
            margin-top: 6;
            margin-bottom: 6;

            StackPage {
              name: "sign-in";

              child: Button sign_in_button {
                action-name: "app.sign-in";

                styles [
                  "flat",
                ]

                child: Box {
                  spacing: 12;

                  // Decorative: the button's name is its label. The text (never shown: no
                  // initials) gives the avatar one colour; with none it picks one at random.
                  Adw.Avatar {
                    size: 28;
                    text: "sign-in";
                    show-initials: false;
                    icon-name: "avatar-default-symbolic";
                    accessible-role: presentation;
                  }

                  Label {
                    label: _("Sign In…");
                    xalign: 0;
                    hexpand: true;
                    ellipsize: end;

                    styles [
                      "heading",
                    ]
                  }
                };
              };
            }

            StackPage {
              name: "account";

              child: MenuButton account_button {
                direction: up;
                always-show-arrow: true;

                styles [
                  "flat",
                ]

                child: Box {
                  spacing: 12;

                  Adw.Avatar account_avatar {
                    size: 28;
                    show-initials: true;
                    accessible-role: presentation;
                  }

                  Label account_label {
                    label: _("Signed In");
                    xalign: 0;
                    hexpand: true;
                    ellipsize: end;

                    styles [
                      "heading",
                    ]
                  }
                };
              };
            }
          }
        };
      };

      // Each page in the navigation view carries its own header bar; the banners below are
      // docked under the visible page's (window.py).
      content: Adw.NavigationPage content_page {
        title: _("Home");
        tag: "content";
        child: Adw.NavigationView navigation_view {};
      };
    };
    };
  };
}

// The banners, one while signed out (or the sign-in has expired: window.py retitles it),
// one while the library syncs, which window.py reveals and moves under the visible page's
// header bar, so the window controls stay level with the sidebar's.
Adw.Banner sign_in_banner {
  title: _("Sign in to see your library");
  button-label: _("Sign In");
  action-name: "app.sign-in";
}

Adw.Banner sync_banner {
  title: _("Syncing your library…");
}

menu primary_menu {
  section {
    item {
      label: _("_Refresh Library");
      action: "app.sync";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Music Sleeve");
      action: "app.about";
    }
  }
}

