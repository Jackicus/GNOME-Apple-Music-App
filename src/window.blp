using Gtk 4.0;
using Adw 1;

template $AppleMusicWindow: Adw.ApplicationWindow {
  title: _("Apple Music");
  width-request: 360;
  height-request: 294;

  // The last breakpoint that matches is the one applied, so the narrower one repeats the
  // wider one's setters.
  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split_view.collapsed: true;
      sidebar.mode: page;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      split_view.collapsed: true;
      sidebar.mode: page;
      player_bar.compact: true;
      now_playing.compact: true;
    }
  }

  // Disjoint from the two above: the Now Playing sheet's two-column layout.
  Adw.Breakpoint {
    condition ("min-width: 900sp")

    setters {
      now_playing.wide: true;
    }
  }

  // The player bar is the bottom sheet's bottom bar, always shown under the content and the
  // window's full width (not full-width, it floats over the content as a pill the width of
  // its controls, which covers the tiles); the sheet over it is Now Playing
  // (widgets/now_playing.blp), which the bar's click, a swipe and app.now-playing open.
  // Toasts go over the content, above the bar, or into the sheet while it is open.
  content: Adw.BottomSheet bottom_sheet {
    bottom-bar: $AppleMusicPlayerBar player_bar {};

    sheet: $AppleMusicNowPlayingSheet now_playing {};

    // The bar is laid over the content, not under it: the content ends above the bar.
    content: Adw.ToastOverlay toast_overlay {
      margin-bottom: bind bottom_sheet.bottom-bar-height;

    child: Adw.NavigationSplitView split_view {
      min-sidebar-width: 220;
      max-sidebar-width: 280;

      sidebar: Adw.NavigationPage {
        title: _("Music");
        tag: "sidebar";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            title-widget: Box {
              spacing: 6;

              Image {
                icon-name: "music-note-symbolic";
                accessible-role: presentation;
              }

              Label {
                label: _("Music");

                styles [
                  "heading",
                ]
              }
            };

            [end]
            MenuButton primary_menu_button {
              icon-name: "open-menu-symbolic";
              menu-model: primary_menu;
              tooltip-text: _("Main Menu");
              primary: true;
            }
          }

          content: Adw.Sidebar sidebar {};

          // The account: Sign In while signed out; the name (or "Signed In") over a menu with
          // Sign Out once signed in.
          [bottom]
          Stack account_stack {
            hhomogeneous: true;
            vhomogeneous: true;
            margin-start: 6;
            margin-end: 6;
            margin-top: 6;
            margin-bottom: 6;

            StackPage {
              name: "sign-in";

              child: Button sign_in_button {
                action-name: "app.sign-in";

                styles [
                  "flat",
                  "account-button",
                ]

                child: Box {
                  spacing: 10;

                  // Decorative: the button's name is its label.
                  Adw.Avatar {
                    size: 28;
                    icon-name: "avatar-default-symbolic";
                    accessible-role: presentation;
                  }

                  Label {
                    label: _("Sign In");
                    xalign: 0;
                    hexpand: true;
                    ellipsize: end;

                    styles [
                      "heading",
                    ]
                  }
                };
              };
            }

            StackPage {
              name: "account";

              child: MenuButton account_button {
                menu-model: account_menu;
                direction: up;
                tooltip-text: _("Account");

                styles [
                  "flat",
                  "account-button",
                ]

                child: Box {
                  spacing: 10;

                  Adw.Avatar account_avatar {
                    size: 28;
                    show-initials: true;
                    accessible-role: presentation;
                  }

                  Label account_label {
                    label: _("Signed In");
                    xalign: 0;
                    hexpand: true;
                    ellipsize: end;

                    styles [
                      "heading",
                    ]
                  }
                };
              };
            }
          }
        };
      };

      content: Adw.NavigationPage content_page {
        title: _("Home");
        tag: "content";

        // Each page in the navigation view carries its own header bar; the banners sit above
        // them: one while signed out, one while the library syncs (window.py reveals them).
        child: Adw.ToolbarView {
          [top]
          Adw.Banner sign_in_banner {
            title: _("Sign in to see your library");
            button-label: _("Sign In");
            button-clicked => $on_banner_sign_in();
          }

          [top]
          Adw.Banner sync_banner {
            title: _("Syncing your library…");
          }

          content: Adw.NavigationView navigation_view {};
        };
      };
    };
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Refresh Library");
      action: "app.sync";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Apple Music");
      action: "app.about";
    }
  }
}

menu account_menu {
  section {
    item {
      label: _("Sign _Out");
      action: "app.sign-out";
    }
  }
}
