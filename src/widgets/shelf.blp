using Gtk 4.0;

// A title row over a horizontal row of tiles that scrolls sideways. The page scrolls
// vertically around it: the row's scrolled window never scrolls vertically, so a vertical
// wheel over it goes on to the page's (see shelf.py).
template $AppleMusicShelf: Box {
  orientation: vertical;

  Box {
    spacing: 6;
    margin-start: 24;
    margin-end: 14;

    styles [
      "shelf-header",
    ]

    Label title_label {
      xalign: 0;
      valign: center;
      hexpand: true;
      ellipsize: end;

      styles [
        "title-2",
      ]
    }

    // Page the row sideways, for a pointer without a sideways wheel: shown while the row
    // overflows, except in a narrow window, where the title needs the room; each sensitive
    // while there is more that way (shelf.py).
    Button previous_button {
      icon-name: "go-previous-symbolic";
      tooltip-text: _("Scroll Left");
      valign: center;
      visible: false;

      styles [
        "flat",
        "circular",
      ]
    }

    Button next_button {
      icon-name: "go-next-symbolic";
      tooltip-text: _("Scroll Right");
      valign: center;
      visible: false;

      styles [
        "flat",
        "circular",
      ]
    }

    // Shown only when the row does not show everything (shelf.py); described by the title,
    // so that each shelf's reads differently.
    Button see_all_button {
      label: _("See All");
      valign: center;
      visible: false;

      accessibility {
        described-by: [
          title_label,
        ];
      }

      styles [
        "flat",
      ]
    }
  }

  ScrolledWindow scrolled_window {
    hscrollbar-policy: automatic;
    vscrollbar-policy: never;

    // Recycled like the grids: a Gtk.ListView as the scrolled window's own child. Its
    // factory and handlers are shelf.py's, connected weakly.
    child: ListView list_view {
      orientation: horizontal;
      single-click-activate: true;
      tab-behavior: item;

      styles [
        "shelf-list",
      ]
    };
  }
}
