using Gtk 4.0;

template $AppleMusicSongTitle: Box {
  spacing: 12;

  // The thumbnail. A cover keeps to its own size (it does not expand), so the title starts
  // right after it whatever the column's width. The track playing has a play icon laid over
  // it (shown by opacity: nothing in a recycled row changes size).
  Overlay {
    valign: center;

    child: $AppleMusicCover cover {
      size: 32;

      styles [
        "small",
      ]
    };

    [overlay]
    Box playing_scrim {
      opacity: 0;
      can-target: false;
      accessible-role: presentation;

      styles [
        "osd",
        "playing-scrim",
      ]

      Image {
        icon-name: "media-playback-start-symbolic";
        hexpand: true;
        accessible-role: presentation;
      }
    }
  }

  Box {
    spacing: 6;

    // A label rather than a Gtk.Inscription, so the badge follows the title's text. One
    // line only: measuring it again at every rebind is cheap, unlike a wrapping label.
    Label label {
      xalign: 0;
      ellipsize: end;
      single-line-mode: true;

      styles [
        "track-title",
      ]
    }

    Label explicit_badge {
      // Translators: the badge marking a song with explicit lyrics, as Apple Music shows it
      label: C_("explicit badge", "E");
      tooltip-text: _("Explicit");
      valign: center;
      visible: false;

      accessibility {
        label: _("Explicit");
      }

      styles [
        "caption",
        "explicit-badge",
      ]
    }
  }
}
