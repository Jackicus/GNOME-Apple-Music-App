using Gtk 4.0;
using Adw 1;

template $AppleMusicSearchPage: Adw.NavigationPage {
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 200;

    // Narrow: the mode toggle goes under the entry, as wide as the page (side by side they
    // need about 640 px).
    Adw.Breakpoint {
      condition ("max-width: 640sp")

      setters {
        search_row.orientation: vertical;
        search_row.halign: fill;
        search_entry.hexpand: true;
        search_entry.width-request: -1;
        mode_toggle.halign: center;
      }
    }

    // Narrower still: the category tiles one a line, too (two would break their names
    // mid-word). The last breakpoint that matches is the one applied: this repeats the one
    // above.
    Adw.Breakpoint {
      condition ("max-width: 520sp")

      setters {
        search_row.orientation: vertical;
        search_row.halign: fill;
        search_entry.hexpand: true;
        search_entry.width-request: -1;
        mode_toggle.halign: center;
        categories_box.min-children-per-line: 1;
        categories_box.max-children-per-line: 1;
      }
    }

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        show-title: false;
      }

      content: Box {
        orientation: vertical;

        styles [
          "view",
        ]

        Label title_label {
          xalign: 0;
          ellipsize: end;
          margin-start: 24;
          margin-end: 24;
          margin-top: 24;

          styles [
            "title-1",
          ]
        }

        // The entry and the mode on the page's 24 px margin, as the title and the results
        // are. The page's handlers are connected in search.py (weakly: sign-out drops it).
        Box search_row {
          spacing: 12;
          halign: start;
          margin-start: 24;
          margin-end: 24;
          margin-top: 12;
          margin-bottom: 12;

          SearchEntry search_entry {
            width-request: 360;
            placeholder-text: _("Search Apple Music");

            accessibility {
              label: _("Search");
            }
          }

          Adw.ToggleGroup mode_toggle {
            valign: center;

            accessibility {
              label: _("Search In");
            }

            Adw.Toggle {
              name: "music";
              label: _("Apple Music");
            }

            Adw.Toggle {
              name: "library";
              label: _("Your Library");
            }
          }
        }

        Stack stack {
          vexpand: true;

          StackPage {
            name: "loading";

            child: Adw.Spinner {
              width-request: 32;
              height-request: 32;
              halign: center;
              valign: center;
            };
          }

          // Engine down, signed out, a failed search, no results, or Your Library before
          // anything is typed: one status page, worded by search.py.
          StackPage {
            name: "status";

            child: Adw.StatusPage status_page {
              child: Box {
                orientation: vertical;
                spacing: 12;
                halign: center;

                Button status_button {
                  visible: false;

                  styles [
                    "pill",
                    "suggested-action",
                  ]
                }

                // Your Library works whatever the engine: offered where Apple Music cannot
                // answer (the engine down, signed out, the demo), as the plain second button
                // under the suggested one.
                Button status_library_button {
                  label: _("Search Your Library");
                  visible: false;

                  styles [
                    "pill",
                  ]
                }
              };
            };
          }

          // Before anything is typed: Apple's browse categories, a flow box of tiles (a few
          // tens, made once each; a Gtk.GridView could not sit under the heading in one
          // scrolled window).
          StackPage {
            name: "landing";

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: Box {
                orientation: vertical;
                spacing: 12;
                margin-bottom: 18;

                Label {
                  label: _("Browse Categories");
                  xalign: 0;
                  ellipsize: end;
                  margin-start: 24;
                  margin-end: 24;

                  styles [
                    "title-2",
                  ]
                }

                FlowBox categories_box {
                  homogeneous: true;
                  selection-mode: none;
                  activate-on-single-click: true;
                  min-children-per-line: 2;
                  max-children-per-line: 6;
                  column-spacing: 12;
                  row-spacing: 12;
                  valign: start;
                  margin-start: 24;
                  margin-end: 24;
                }
              };
            };
          }

          // While typing: Apple's completions of the term and its top hits for it.
          StackPage {
            name: "suggestions";

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: Adw.Clamp {
                maximum-size: 600;
                tightening-threshold: 480;
                margin-start: 24;
                margin-end: 24;
                margin-top: 6;
                margin-bottom: 18;

                child: ListBox suggestions_list {
                  selection-mode: none;
                  valign: start;

                  styles [
                    "boxed-list",
                  ]
                };
              };
            };
          }

          // After Enter: one shelf per kind, in Apple's order, Top Results as cards.
          StackPage {
            name: "results";

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: Box results_box {
                orientation: vertical;
                spacing: 18;
                margin-top: 6;
                margin-bottom: 18;
              };
            };
          }

          // Your Library: the cached models filtered as you type, three shelves and a list
          // of songs (the first SONG_LIMIT; See All opens the Songs page with the filter).
          StackPage {
            name: "library";

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: Box library_box {
                orientation: vertical;
                spacing: 18;
                margin-top: 6;
                margin-bottom: 18;

                $AppleMusicShelf albums_shelf {
                  see-all: true;
                }

                $AppleMusicShelf artists_shelf {
                  see-all: true;
                }

                $AppleMusicShelf playlists_shelf {
                  see-all: true;
                }

                Box songs_box {
                  orientation: vertical;

                  Box {
                    spacing: 12;
                    margin-start: 24;
                    margin-end: 14;

                    styles [
                      "shelf-header",
                    ]

                    Box {
                      orientation: vertical;
                      valign: center;
                      hexpand: true;

                      Label songs_title_label {
                        label: _("Songs");
                        xalign: 0;
                        ellipsize: end;

                        styles [
                          "title-2",
                        ]
                      }

                      Label songs_count_label {
                        xalign: 0;
                        ellipsize: end;

                        styles [
                          "dimmed",
                        ]
                      }
                    }

                    Button songs_see_all_button {
                      label: _("See All");
                      valign: center;

                      accessibility {
                        described-by: [
                          songs_title_label,
                        ];
                      }

                      styles [
                        "flat",
                      ]
                    }
                  }

                  // A short list in the page's own scrolled window: at most SONG_LIMIT rows,
                  // so the list need not recycle (it cannot, inside a box). A click plays a
                  // song, as GNOME Music plays one (docs/decisions.md).
                  ListView songs_list {
                    single-click-activate: true;
                    tab-behavior: item;

                    styles [
                      "track-list",
                    ]
                  }
                }
              };
            };
          }
        }
      };
    };
  };
}
