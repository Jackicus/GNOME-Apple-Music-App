using Gtk 4.0;
using Adw 1;

template $AppleMusicArtistPage: Adw.NavigationPage {
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 200;

    // Narrow: the portrait goes above the name, and the hero centres.
    Adw.Breakpoint {
      condition ("max-width: 600sp")

      setters {
        hero_row.orientation: vertical;
        avatar.halign: center;
        name_label.xalign: 0.5;
        name_label.justify: center;
        caption_label.xalign: 0.5;
        caption_label.justify: center;
        buttons_box.halign: center;
      }
    }

    // Narrower still (a phone): two album tiles a row need narrower margins, or they would
    // make the page wider than the window. The last breakpoint that matches is the one
    // applied, so this repeats the one above.
    Adw.Breakpoint {
      condition ("max-width: 400sp")

      setters {
        hero_row.orientation: vertical;
        avatar.halign: center;
        name_label.xalign: 0.5;
        name_label.justify: center;
        caption_label.xalign: 0.5;
        caption_label.justify: center;
        buttons_box.halign: center;
        content_box.margin-start: 12;
        content_box.margin-end: 12;
      }
    }

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar header_bar {}

      // A box of a few tens of tiles, not a Gtk.GridView: an artist has tens of albums, and a
      // flow box can sit under the hero in one scrolled window.
      content: ScrolledWindow scrolled_window {
        hscrollbar-policy: never;

        child: Box content_box {
          orientation: vertical;
          spacing: 18;
          margin-start: 24;
          margin-end: 24;
          margin-top: 24;
          margin-bottom: 24;

          Box hero_row {
            spacing: 24;

            // Decorative: the name follows it.
            Adw.Avatar avatar {
              size: 200;
              show-initials: true;
              accessible-role: presentation;
            }

            Box {
              orientation: vertical;
              valign: center;
              hexpand: true;
              spacing: 6;

              Label name_label {
                xalign: 0;
                wrap: true;
                wrap-mode: word_char;

                styles [
                  "title-1",
                ]
              }

              Label caption_label {
                xalign: 0;
                wrap: true;

                styles [
                  "caption",
                  "dimmed",
                ]
              }

              // Play (a catalog artist's top songs) and the artist's own menu.
              Box buttons_box {
                spacing: 12;
                margin-top: 12;

                Button play_button {
                  visible: false;

                  child: Adw.ButtonContent {
                    icon-name: "media-playback-start-symbolic";
                    label: _("Play");
                  };

                  styles [
                    "pill",
                    "suggested-action",
                  ]
                }

                MenuButton more_button {
                  icon-name: "view-more-symbolic";
                  tooltip-text: _("More Options");
                  valign: center;

                  accessibility {
                    label: _("More Options");
                  }

                  styles [
                    "circular",
                  ]
                }
              }
            }
          }

          Label albums_label {
            label: _("Albums");
            xalign: 0;
            margin-top: 12;

            styles [
              "title-2",
            ]
          }

          // Each tile at the start of its cell, the first on the page's margin (and a
          // child's 3 px padding), 12 px apart, as Radio's.
          FlowBox flow_box {
            homogeneous: true;
            selection-mode: none;
            activate-on-single-click: true;
            min-children-per-line: 2;
            max-children-per-line: 12;
            column-spacing: 12;
            valign: start;
          }

          // The biography after the albums, three lines at most: More shows it whole.
          Box summary_box {
            orientation: vertical;
            spacing: 6;
            margin-top: 12;
            visible: false;

            Label {
              label: _("About");
              xalign: 0;

              styles [
                "title-2",
              ]
            }

            Label summary_label {
              xalign: 0;
              wrap: true;
              lines: 3;
              ellipsize: end;

              styles [
                "dimmed",
              ]
            }

            Button more_notes_button {
              label: _("More");
              halign: start;
              visible: false;

              styles [
                "flat",
              ]
            }
          }

          // In place of the albums: an artist that came without them (a shelf's) while the
          // engine fetches them, or what stopped the fetch (artist.py sets the texts).
          Adw.StatusPage status_page {
            icon-name: "media-optical-cd-audio-symbolic";
            visible: false;

            child: Button status_button {
              halign: center;
              styles [
                "pill",
              ]
            };

            styles [
              "compact",
            ]
          }
        };
      };
    };
  };
}
