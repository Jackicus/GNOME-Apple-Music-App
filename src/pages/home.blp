using Gtk 4.0;
using Adw 1;

template $AppleMusicHomePage: Adw.NavigationPage {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar header_bar {
      show-title: false;
    }

    content: Stack stack {
      StackPage {
        name: "loading";

        child: Adw.Spinner {
          width-request: 32;
          height-request: 32;
          halign: center;
          valign: center;
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage empty_page {
          title: _("Nothing to Show Yet");
          description: _("Recommendations and the music you play appear here");
        };
      }

      StackPage {
        name: "items";

        // A box of shelves, not a list: a page has a handful, and each recycles its own tiles
        // in its own scrolled window. On the view background, as the grids and lists are.
        child: ScrolledWindow scrolled_window {
          hscrollbar-policy: never;

          styles [
            "view",
          ]

          child: Box shelves_box {
            orientation: vertical;
            spacing: 18;
            margin-bottom: 18;

            Label title_label {
              xalign: 0;
              ellipsize: end;
              margin-start: 24;
              margin-end: 24;
              margin-top: 24;

              styles [
                "title-1",
              ]
            }
          };
        };
      }
    };
  };
}
