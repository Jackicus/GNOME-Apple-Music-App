using Gtk 4.0;
using Adw 1;

template $AppleMusicSongsPage: Adw.NavigationPage {
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 200;

    // Narrow: the album column goes, and the title column gives up what the time column
    // needs, so that title, artist and time fit a 360 px window.
    Adw.Breakpoint {
      condition ("max-width: 560sp")

      setters {
        album_column.visible: false;
        title_column.fixed-width: 160;
      }
    }

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar header_bar {
        show-title: false;

        [end]
        MenuButton sort_button {
          icon-name: "view-sort-descending-symbolic";
          tooltip-text: _("Sort By");
          menu-model: sort_menu;
          visible: false;

          accessibility {
            label: _("Sort By");
          }
        }

        // Shows the filter bar below, as the search button of GNOME's apps does.
        [end]
        ToggleButton search_button {
          icon-name: "edit-find-symbolic";
          tooltip-text: _("Filter Songs");
          visible: false;

          accessibility {
            label: _("Filter Songs");
          }
        }
      }

      // The filter, under the header bar: revealed by the button, by Ctrl+F and by typing on
      // the page (songs.py makes the page its key-capture widget); Escape or the button
      // closes it, which clears the entry and so the filter.
      [top]
      SearchBar search_bar {
        search-mode-enabled: bind search_button.active bidirectional;

        child: SearchEntry filter_entry {
          placeholder-text: _("Filter Songs");
          hexpand: true;
          search-changed => $on_filter_changed();
          stop-search => $on_stop_search();

          accessibility {
            label: _("Filter Songs");
          }
        };
      }

      content: Stack stack {
        StackPage {
          name: "loading";

          child: Adw.Spinner {
            width-request: 32;
            height-request: 32;
            halign: center;
            valign: center;
          };
        }

        StackPage {
          name: "empty";
          child: Adw.StatusPage empty_page {};
        }

        StackPage {
          name: "items";

          // The title stays put above the table: a Gtk.ColumnView only recycles its rows as
          // the scrollable child of a Gtk.ScrolledWindow, and its header row is its own. On
          // the view background, as the grid pages' titles are.
          child: Box {
            orientation: vertical;

            styles [
              "view",
            ]

            Box {
              spacing: 12;
              margin-start: 24;
              margin-end: 24;
              margin-top: 24;
              margin-bottom: 12;

              Label title_label {
                xalign: 0;
                ellipsize: end;
                valign: baseline_fill;

                styles [
                  "title-1",
                ]
              }

              Label count_label {
                xalign: 0;
                hexpand: true;
                ellipsize: end;
                valign: baseline_fill;

                styles [
                  "dimmed",
                ]
              }
            }

            Stack results_stack {
              vexpand: true;

              StackPage {
                name: "table";

                child: ScrolledWindow {
                  hscrollbar-policy: never;

                  // A click plays a song, as GNOME Music plays one (docs/decisions.md): the
                  // links, the context menu and a drag claim their presses before the row
                  // sees them. No row separators, as a playlist's table has none.
                  child: ColumnView column_view {
                    tab-behavior: item;
                    single-click-activate: true;
                    activate => $on_activate();

                    styles [
                      "songs-table",
                    ]

                    // Fixed widths, shared out as the table grows, keep the columns from
                    // measuring their cells: rows are rebound all the time while scrolling,
                    // and widths that followed the text shown would jump as it changed.
                    // Without the album column, and the title column narrowed, they fit a
                    // 360 px window: 356 px.
                    ColumnViewColumn title_column {
                      title: _("Title");
                      fixed-width: 170;
                      expand: true;
                      resizable: true;
                    }

                    ColumnViewColumn artist_column {
                      title: _("Artist");
                      fixed-width: 100;
                      expand: true;
                      resizable: true;
                    }

                    ColumnViewColumn album_column {
                      title: _("Album");
                      fixed-width: 100;
                      expand: true;
                      resizable: true;
                    }

                    // Room for an hour or more ("1:02:03", 56 px at Adwaita Sans 11) beside
                    // the cell's 6 px and the page margin's 24 px.
                    ColumnViewColumn time_column {
                      title: _("Time");
                      fixed-width: 96;
                    }
                  };
                };
              }

              StackPage {
                name: "no-results";

                child: Adw.StatusPage {
                  icon-name: "edit-find-symbolic";
                  title: _("No Results Found");
                  description: _("Try a different filter");
                };
              }
            }
          };
        }
      };
    };
  };
}

// The Sort By menu (songs.py's songs.* actions): the keyboard's way to sort, as the column
// headers take no focus.
menu sort_menu {
  section {
    item {
      label: _("Title");
      action: "songs.sort-column";
      target: "title";
    }

    item {
      label: _("Artist");
      action: "songs.sort-column";
      target: "artist";
    }

    item {
      label: _("Album");
      action: "songs.sort-column";
      target: "album";
    }

    item {
      label: _("Time");
      action: "songs.sort-column";
      target: "time";
    }
  }

  section {
    item {
      label: _("Ascending");
      action: "songs.sort-order";
      target: "ascending";
    }

    item {
      label: _("Descending");
      action: "songs.sort-order";
      target: "descending";
    }
  }
}
