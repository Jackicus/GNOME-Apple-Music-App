using Gtk 4.0;
using Adw 1;

// The transport bar at the bottom of the window (player_bar.py): the AdwBottomSheet's bottom
// bar, which the window reveals only while something plays (window.py). Transport on the
// left; the item playing (artwork, title with its explicit badge, artist) with the seek
// slider under it in the middle; the heart, shuffle, repeat and the volume on the right.
// With nothing playing (the bar on its way out) the seek slider and the heart are hidden
// and "Not Playing" centres beside the cover. The window's breakpoint sets `compact` below
// 600sp, which hides the right-hand box (the Now Playing sheet has shuffle and repeat) and
// the times around the slider, and shrinks the cover, so the title has the room at 360 px.
template $AppleMusicPlayerBar: Adw.Bin {
  child: Box {
    spacing: 12;
    margin-start: 12;
    margin-end: 12;
    margin-top: 6;
    margin-bottom: 6;

    styles [
      "player-bar",
    ]

    Box {
      spacing: 6;
      valign: center;

      Button {
        icon-name: "media-skip-backward-symbolic";
        tooltip-text: _("Previous");
        action-name: "app.previous";
        valign: center;

        styles [
          "flat",
          "circular",
        ]
      }

      Button play_button {
        icon-name: "transport-play-symbolic";
        tooltip-text: _("Play");
        action-name: "app.play-pause";
        valign: center;

        styles [
          "circular",
          "suggested-action",
          "play-button",
        ]
      }

      Button {
        icon-name: "media-skip-forward-symbolic";
        tooltip-text: _("Next");
        action-name: "app.next";
        valign: center;

        styles [
          "flat",
          "circular",
        ]
      }
    }

    Box {
      spacing: 12;
      hexpand: true;

      $AppleMusicCover cover {
        size: 44;
        valign: center;

        styles [
          "small",
        ]
      }

      Box {
        orientation: vertical;
        valign: center;
        hexpand: true;

        Box {
          spacing: 6;

          Label title_label {
            label: _("Not Playing");
            xalign: 0;
            ellipsize: end;
            single-line-mode: true;

            styles [
              "heading",
            ]
          }

          Label explicit_badge {
            // Translators: the badge marking a song with explicit lyrics, as Apple Music shows it
            label: C_("explicit badge", "E");
            tooltip-text: _("Explicit");
            valign: center;
            visible: false;

            accessibility {
              label: _("Explicit");
            }

            styles [
              "caption",
              "explicit-badge",
            ]
          }
        }

        Label subtitle_label {
          xalign: 0;
          ellipsize: end;
          single-line-mode: true;
          visible: false;

          styles [
            "dimmed",
            "caption",
          ]
        }

        Box seek_box {
          spacing: 6;
          sensitive: false;
          visible: false;

          Label elapsed_label {
            label: "0:00";
            xalign: 1;
            width-chars: 5;
            valign: center;

            styles [
              "numeric",
              "caption",
              "dimmed",
            ]
          }

          Scale seek_scale {
            hexpand: true;
            valign: center;
            draw-value: false;
            adjustment: Adjustment seek_adjustment {
              lower: 0;
              upper: 1;
              step-increment: 5;
              page-increment: 30;
            };

            accessibility {
              label: _("Position");
            }
          }

          Label remaining_label {
            label: "-0:00";
            xalign: 0;
            width-chars: 6;
            valign: center;

            styles [
              "numeric",
              "caption",
              "dimmed",
            ]
          }
        }
      }
    }

    // Hidden whole in `compact`: its spacing would come off the title too.
    Box controls_box {
      spacing: 6;
      valign: center;

      // Whether the item playing is loved: a click loves or unloves it (widgets/transport.py).
      // Its name stays "Favourite"; the tooltip says what a click does now.
      ToggleButton heart_button {
        icon-name: "heart-outline-symbolic";
        tooltip-text: _("Favourite");
        sensitive: false;
        visible: false;
        valign: center;

        accessibility {
          label: _("Favourite");
        }

        styles [
          "flat",
          "heart-button",
        ]
      }

      ToggleButton shuffle_button {
        icon-name: "media-playlist-shuffle-symbolic";
        tooltip-text: _("Shuffle");
        sensitive: false;
        valign: center;

        styles [
          "flat",
        ]
      }

      ToggleButton repeat_button {
        icon-name: "media-playlist-repeat-symbolic";
        tooltip-text: _("Repeat");
        sensitive: false;
        valign: center;

        styles [
          "flat",
        ]
      }

      ScaleButton volume_button {
        icons: [
          "audio-volume-muted-symbolic",
          "audio-volume-high-symbolic",
          "audio-volume-low-symbolic",
          "audio-volume-medium-symbolic",
        ];
        adjustment: Adjustment volume_adjustment {
          lower: 0;
          upper: 1;
          step-increment: 0.05;
          page-increment: 0.1;
          value: 1;
        };
        tooltip-text: _("Volume");
        sensitive: false;
        valign: center;

        styles [
          "flat",
        ]
      }
    }
  };
}
