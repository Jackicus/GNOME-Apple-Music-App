import os
import signal
import sys

VERSION = '@VERSION@'
APP_ID = '@APP_ID@'
BASE_ID = '@BASE_ID@'
PROFILE = '@PROFILE@'
DEMO_DIR = '@DEMO_DIR@'
pkgdatadir = '@pkgdatadir@'
localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)

from applemusic import i18n  # noqa: E402

i18n.setup(localedir)  # for Python's gettext and GtkBuilder's, before anything is translated

if __name__ == '__main__':
    from gi.repository import Gio

    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'applemusic.gresource'))
    resource._register()

    from applemusic import main

    sys.exit(main.main(VERSION, APP_ID, BASE_ID, PROFILE, DEMO_DIR))
