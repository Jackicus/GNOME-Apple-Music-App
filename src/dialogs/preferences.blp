using Gtk 4.0;
using Adw 1;

// Preferences (app.preferences, Ctrl+,): each row bound to its setting in preferences.py.
// Switch and action rows carry a short, header-capitalised title and say the rest in their
// subtitle, as Settings does; an entry row's title is sentence-cased.
template $AppleMusicPreferencesDialog: Adw.PreferencesDialog {
  Adw.PreferencesPage general_page {
    name: "general";
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Playback");

      Adw.SwitchRow background_row {
        title: _("Background Playback");
        subtitle: _("Keep playing when the window is closed; the system’s media controls bring it back");
      }

      Adw.SwitchRow discord_row {
        title: _("Discord Presence");
        subtitle: _("Show the song playing, with its artist, album and cover, on your Discord profile while Discord is running");
      }
    }

    Adw.PreferencesGroup {
      title: _("Library");

      Adw.ComboRow interval_row {
        title: _("Refresh Library");

        model: StringList {
          strings [
            _("Every hour"),
            _("Every 6 hours"),
            _("Every day"),
            _("Manually"),
          ]
        };
      }

      // The subtitle is when the library was last refreshed (sync.last_sync_text()), or
      // "Refreshing…" while it is; Refresh runs app.sync, off while it cannot run.
      Adw.ActionRow last_refreshed_row {
        title: _("Last Refreshed");

        [suffix]
        Button refresh_button {
          label: _("_Refresh");
          use-underline: true;
          valign: center;
          action-name: "app.sync";
        }
      }

      Adw.ActionRow cache_row {
        title: _("Cache");
        subtitle: _("Calculating…");

        [suffix]
        Button clear_button {
          label: _("C_lear…");
          use-underline: true;
          valign: center;
        }
      }
    }
  }

  Adw.PreferencesPage engine_page {
    name: "engine";
    title: _("Engine");
    icon-name: "web-browser-symbolic";

    Adw.PreferencesGroup {
      description: _("Apple Music plays in Google Chrome, which the app starts and controls in the background.");

      Adw.ActionRow engine_row {
        title: _("Engine");
        subtitle: _("Not running");

        [suffix]
        Button engine_button {
          label: _("_Start");
          use-underline: true;
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Browser");
      description: _("The browser program is a program name or path, without arguments. Changes here apply the next time the engine starts.");

      Adw.EntryRow browser_row {
        title: _("Browser program");
        show-apply-button: true;
      }

      Adw.SwitchRow headless_row {
        title: _("Run Browser Hidden");
        subtitle: _("Turn off to show the Chrome window, for debugging");
      }

      Adw.SwitchRow autostart_row {
        title: _("Start Engine on Launch");
        subtitle: _("Starts Chrome when the app opens, once you have signed in");
      }
    }

    Adw.PreferencesGroup account_group {
      title: _("Account");

      // Neither runs its action through action-name: Sign In closes Preferences first, and
      // Sign Out is insensitive while it runs, which an actionable row would undo.
      Adw.ButtonRow sign_in_row {
        title: _("Sign _In…");
        use-underline: true;
      }

      Adw.ButtonRow sign_out_row {
        title: _("Sign _Out…");
        use-underline: true;

        styles [
          "destructive-action",
        ]
      }
    }
  }
}
