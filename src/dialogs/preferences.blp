using Gtk 4.0;
using Adw 1;

// Preferences (app.preferences, Ctrl+,): each row bound to its setting in preferences.py.
template $AppleMusicPreferencesDialog: Adw.PreferencesDialog {
  Adw.PreferencesPage general_page {
    name: "general";
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Playback");

      Adw.SwitchRow background_row {
        title: _("Keep playing when the window is closed");
        subtitle: _("The music plays on in the background, and the system's media controls bring the window back");
      }
    }

    Adw.PreferencesGroup {
      title: _("Library");

      Adw.ComboRow interval_row {
        title: _("Refresh library");

        model: StringList {
          strings [
            _("Every hour"),
            _("Every 6 hours"),
            _("Every day"),
            _("Manually"),
          ]
        };
      }

      Adw.ButtonRow refresh_row {
        title: _("_Refresh Now");
        use-underline: true;
        start-icon-name: "view-refresh-symbolic";
        action-name: "app.sync";
      }

      Adw.ActionRow cache_row {
        title: _("Cache");
        subtitle: _("Calculating…");

        [suffix]
        Button clear_button {
          label: _("C_lear");
          use-underline: true;
          valign: center;
          clicked => $on_clear_clicked();
        }
      }
    }
  }

  Adw.PreferencesPage engine_page {
    name: "engine";
    title: _("Engine");
    icon-name: "web-browser-symbolic";

    Adw.PreferencesGroup {
      description: _("Apple Music plays in Google Chrome, which the app starts and controls in the background.");

      Adw.ActionRow engine_row {
        title: _("Engine");
        subtitle: _("Not running");

        [suffix]
        Button engine_button {
          label: _("_Start");
          use-underline: true;
          valign: center;
          clicked => $on_engine_clicked();
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Browser");
      description: _("Changes to the browser command and the port apply the next time the engine starts.");

      Adw.EntryRow browser_row {
        title: _("Browser command");
      }

      Adw.SpinRow port_row {
        title: _("DevTools port");
        subtitle: _("Applies the next time the engine starts");
        numeric: true;

        adjustment: Adjustment {
          lower: 1024;
          upper: 65535;
          step-increment: 1;
          page-increment: 10;
        };
      }

      Adw.SwitchRow headless_row {
        title: _("Run the browser hidden");
        subtitle: _("Turn off to see the Chrome window, which helps with debugging; applies the next time the engine starts");
      }

      Adw.SwitchRow autostart_row {
        title: _("Start the engine with the app");
        subtitle: _("Starts Chrome when the app opens, once you have signed in");
      }
    }

    Adw.PreferencesGroup account_group {
      title: _("Account");

      // Runs app.sign-out, though not through action-name: an actionable's sensitivity is
      // its action's, and this one is off while signed out.
      Adw.ButtonRow sign_out_row {
        title: _("Sign _Out");
        use-underline: true;
        activated => $on_sign_out_activated();

        styles [
          "destructive-action",
        ]
      }
    }
  }
}
