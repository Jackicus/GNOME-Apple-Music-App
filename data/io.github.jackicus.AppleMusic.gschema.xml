<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="apple-music">
  <schema id="io.github.jackicus.AppleMusic" path="/io/github/jackicus/AppleMusic/">
    <key name="window-width" type="i">
      <default>1100</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>760</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Whether the window is maximized</summary>
    </key>
    <key name="last-page" type="s">
      <default>'home'</default>
      <summary>Last page shown</summary>
      <description>The sidebar item that was selected when the window closed: a destination's key, or "playlist:ID" or "folder:ID" for one of the library's playlists or folders.</description>
    </key>
    <key name="expanded-folders" type="as">
      <default>[]</default>
      <summary>Expanded playlist folders</summary>
      <description>The ids of the playlist folders shown open in the sidebar, their contents listed under them.</description>
    </key>
  </schema>
</schemalist>
