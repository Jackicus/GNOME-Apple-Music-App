[Desktop Entry]
Name=Apple Music
Comment=Play your library, playlists and radio
Exec=apple-music
Icon=@APP_ID@
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;GTK;GNOME;
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons.
