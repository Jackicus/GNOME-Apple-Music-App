<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>

  <name>Music Sleeve@NAME_SUFFIX@</name>
  <summary>Play your Apple Music library, playlists and radio</summary>
  <description>
    <p>
      A GNOME app for Apple Music: your library, playlists, radio and
      recommendations in a native interface, laid out like Apple's web player.
    </p>
    <p>
      Playback runs through Google Chrome, which the app starts in the
      background: Apple's streams are protected with Widevine, which Google
      Chrome includes and Chromium does not. It needs Google Chrome and an
      Apple Music subscription.
    </p>
    <p>
      The app talks only to Apple, and controls its Chrome through a private
      pipe rather than a network port. Chrome keeps its own connections to
      Google, as any Chrome does, for example to update the Widevine module.
    </p>
    <p>
      Not affiliated with Apple. Apple Music is a trademark of Apple Inc.
    </p>
  </description>

  <developer id="io.github.jackicus">
    <name translate="no">Jack Tully</name>
  </developer>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <url type="homepage">https://github.com/Jackicus/GNOME-Music-Sleeve</url>
  <url type="bugtracker">https://github.com/Jackicus/GNOME-Music-Sleeve/issues</url>
  <url type="help">https://github.com/Jackicus/GNOME-Music-Sleeve/blob/main/docs/user-guide.md</url>
  <url type="vcs-browser">https://github.com/Jackicus/GNOME-Music-Sleeve</url>
  <url type="contribute">https://github.com/Jackicus/GNOME-Music-Sleeve/blob/main/CONTRIBUTING.md</url>
  <url type="translate">https://github.com/Jackicus/GNOME-Music-Sleeve/blob/main/CONTRIBUTING.md#translating</url>

  <translation type="gettext">music-sleeve</translation>

  <provides>
    <binary>music-sleeve</binary>
  </provides>

  <!-- Songs and lyrics marked explicit are played and shown as they are. -->
  <content_rating type="oars-1.1">
    <content_attribute id="language-profanity">intense</content_attribute>
    <content_attribute id="social-info">none</content_attribute>
  </content_rating>

  <requires>
    <display_length compare="ge">360</display_length>
    <internet>always</internet>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <screenshots>
    <screenshot type="default" environment="gnome">
      <caption>Home: your heavy rotation and what you added recently, a song playing below</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Music-Sleeve/v0.11.0/data/screenshots/home-light.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>Your albums in a grid, sorted the way you choose</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Music-Sleeve/v0.11.0/data/screenshots/albums-light.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>An album's page, with its first song playing</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Music-Sleeve/v0.11.0/data/screenshots/album-light.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>Now Playing, with the lyrics following the song</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Music-Sleeve/v0.11.0/data/screenshots/now-playing-light.png</image>
    </screenshot>
    <screenshot environment="gnome:dark">
      <caption>Home: your heavy rotation and what you added recently, a song playing below</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Music-Sleeve/v0.11.0/data/screenshots/home-dark.png</image>
    </screenshot>
    <screenshot environment="gnome:dark">
      <caption>Your albums in a grid, sorted the way you choose</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Music-Sleeve/v0.11.0/data/screenshots/albums-dark.png</image>
    </screenshot>
    <screenshot environment="gnome:dark">
      <caption>An album's page, with its first song playing</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Music-Sleeve/v0.11.0/data/screenshots/album-dark.png</image>
    </screenshot>
    <screenshot environment="gnome:dark">
      <caption>Now Playing, with the lyrics following the song</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Music-Sleeve/v0.11.0/data/screenshots/now-playing-dark.png</image>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#dc8add</color>
    <color type="primary" scheme_preference="dark">#2b1a33</color>
  </branding>

  <releases>
    <release version="0.11.0" date="2026-10-02">
      <description>
        <p>
          A pass over the whole app against GNOME's Human Interface Guidelines, artist
          pages laid out as Apple Music's are, and a way from any song to its album and
          its artist.
        </p>
        <ul>
          <li>An artist's page has what Apple Music's has: the latest release beside the top songs, essential albums, albums, singles and EPs, music videos, playlists, a biography and similar artists, with your own albums by them first</li>
          <li>Go to Album and Go to Artist in a song's menu, and in the player bar's and Now Playing's; the artist and the album in the Songs table are links to their pages</li>
          <li>A playlist's songs are a table in a wide window, as the Songs page's are, with the same links; the Songs filter is a search bar (Ctrl+F); the grid pages sort ascending or descending</li>
          <li>Clicking a song plays that song, where a list could start the one after it; the song playing is marked in its list, and the player bar shows only while something plays</li>
          <li>Typing in GNOME's Activities overview finds your artists, albums, playlists and songs, and opens or plays the one you choose</li>
          <li>Preferences' rows read as Settings' do, with a Last Refreshed row and its Refresh button; the sidebar is titled Music Sleeve; the library's pages offer Sign In while you are signed out</li>
          <li>Album and playlist pages fit a 360 px window, the player bar's title shows whole there, and the play button has its own play and pause icons, which no icon theme can swap</li>
          <li>Discord presence clears five seconds into a pause, as Spotify's does</li>
        </ul>
      </description>
    </release>
    <release version="0.10.0" date="2026-09-30">
      <description>
        <p>
          What you are listening to can now show on your Discord profile.
        </p>
        <ul>
          <li>Discord rich presence, off until you turn it on in Preferences: the song, its artist, its album and the album's cover, shown as listening to Apple Music, with the time left counting down</li>
          <li>The artist shows in the status under your name, and the presence is taken off when playback ends or the app quits</li>
        </ul>
      </description>
    </release>
    <release version="0.9.0" date="2026-09-30">
      <description>
        <p>
          The first release candidate. With Google Chrome and an Apple Music
          subscription, it plays your library and Apple Music's catalogue:
        </p>
        <ul>
          <li>Your albums, artists, songs, music videos, playlists and playlist folders, synced from your account and browsable offline</li>
          <li>Home, New, Radio, Made for You and Search, with a page for every album, playlist and artist</li>
          <li>A player bar and a Now Playing view with synced lyrics and the queue</li>
          <li>GNOME's media controls and the keyboard's media keys</li>
          <li>Favourites, Play Next and Play Later, and adding to your library and playlists from context menus or by dragging songs</li>
          <li>Playback in the background with the window closed, keyboard navigation throughout, and screen reader labels</li>
          <li>Keys as elsewhere in GNOME: Space presses a focused button and otherwise plays or pauses, and Ctrl+Shift+N opens Now Playing</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
